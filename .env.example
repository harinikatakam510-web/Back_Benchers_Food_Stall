# Copy this file to ".env" and fill in real values.
# On Render, add the same names under Environment -> Environment Variables.

# Razorpay Dashboard -> Account & Settings -> API Keys
# Use rzp_test_... keys while testing, rzp_live_... when going live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Razorpay Dashboard -> Webhooks -> Add New Webhook
#   URL: https://<your-site>/razorpay-webhook   Event: order.paid
# Make up any long random secret and use the SAME value there and here.
RAZORPAY_WEBHOOK_SECRET=make-up-a-long-random-secret

# Login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Leave empty on your own computer (uses database.db).
# REQUIRED on Render, otherwise orders are wiped on every restart.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ONLY on an OLD copy of the site that is being replaced.
# When Razorpay starts blocking payments on the old site (because it
# approved the new one), visitors are automatically sent here.
# Leave empty on the main/new site.
SWITCH_TO_URL=
